# Copy this file to .env for local dev, and set the same keys as
# environment variables in your hosting dashboard (e.g. Cloudflare Pages
# → Settings → Environment variables) for production builds.

# Web3Forms access key — https://web3forms.com (public/client-safe, tied to an email not a password)
PUBLIC_WEB3FORMS_KEY=

# Optional
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_AI_PROXY_URL=
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=

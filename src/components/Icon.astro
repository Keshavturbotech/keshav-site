const raw = PATHS[name] ?? PATHS.Target;
const subpaths = raw.split("|");
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {subpaths.map((d) => <path d={d} />)}
</svg>

---
// src/pages/blog/[slug].astro
// Ported from BlogPostPage in App.jsx (line ~18663), including the
// linkifyBlogText auto-linking behavior (see src/lib/linkifyBlogText.ts for
// what changed in that port — same keyword map, real <a href> instead of
// onClick navigation since Astro renders real URLs).
import Layout from "../../layouts/Layout.astro";
import { localizedPath } from "../../lib/localeMeta";
import ReadingProgressBar from "../../components/islands/ReadingProgressBar.jsx";
import { linkifyBlogText } from "../../lib/linkifyBlogText";
import type { BlogPost } from "../../data/blog-posts";
import { BLOG_POSTS as BLOG_POSTS_EN } from "../../data/blog-posts";
import { CONTACT_INFO } from "../../data/site-config";
import { getLocalizedList } from "../../lib/i18n";

export function getStaticPaths() {
  // Route generation (slugs) stays keyed off the English, build-time,
  // locale-agnostic list — same pattern as products/[slug].astro and
  // services/[slug].astro. postEn only supplies the slug/id used to look up
  // the localized post below; render content always comes from the
  // localized list, never from postEn directly (FIXED — see index.astro).
  return BLOG_POSTS_EN.map((post) => ({
    params: { slug: post.slug },
    props: { postEn: post },
  }));
}

const locale = Astro.currentLocale ?? "en";
const { postEn } = Astro.props;
const BLOG_POSTS = getLocalizedList<BlogPost>("blog-posts", locale);
const post = BLOG_POSTS.find((p) => p.id === postEn.id) ?? postEn;
const others = BLOG_POSTS.filter((p) => p.id !== post.id).slice(0, 2);
// Tracks which link targets have already been used in THIS article, so each
// gets auto-linked on its first mention only — shared across every content
// block below via linkifyBlogText(text, usedGroups).
const usedLinkGroups = new Set<string>();

const SITE_URL = "https://www.keshavturbotech.com";
const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: post.title,
      description: post.excerpt,
      datePublished: post.date,
      url: `${SITE_URL}/blog/${post.slug}`,
      inLanguage: "en-IN",
      keywords: post.tags?.join(", ") || "steam turbine, industrial engineering, Shamli",
      author: { "@type": "Organization", name: post.author },
      publisher: {
        "@type": "Organization",
        name: "Keshav Enterprises",
        url: SITE_URL,
        logo: { "@type": "ImageObject", url: `${SITE_URL}/keshav-logo-icon.png` },
      },
      mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}/blog/${post.slug}` },
      image: post.coverImage ? `${SITE_URL}/${post.coverImage}` : `${SITE_URL}/og-image.webp`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Blog", item: `${SITE_URL}/blog` },
        {
          "@type": "ListItem",
          position: 2,
          name: post.title,
          item: `${SITE_URL}/blog/${post.slug}`,
        },
      ],
    },
  ],
};

const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${SITE_URL}/blog/${post.slug}`)}`;
const waHref = (text: string) =>
  `https://wa.me/${CONTACT_INFO.whatsapp}?text=${encodeURIComponent(text)}`;
---

<Layout
  title={post.title}
  description={post.excerpt}
  canonicalPath={`/blog/${post.slug}`}
  ogImage={post.coverImage ? `/${post.coverImage}` : undefined}
  keywords={post.tags?.length
    ? [...post.tags, "Keshav Enterprises", "turbine engineering India"].join(", ")
    : undefined}
  jsonLd={blogSchema}
>
  <ReadingProgressBar client:load />

  <div class="pt-20 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav
        aria-label="Breadcrumb"
        class="flex items-center text-sm font-bold text-slate-500 mb-8 uppercase tracking-widest flex-wrap gap-2 pt-4"
      >
        <a
          href={localizedPath(locale, "/blog")}
          class="hover:text-blue-600 transition-colors flex items-center focus:outline-none focus-visible:underline"
        >
          <svg
            class="w-4 h-4 mr-2"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0l7 7m-7-7l7-7"
            ></path></svg
          >
          Blog
        </a>
        <span aria-hidden="true" class="mx-1">/</span>
        <span
          class="text-slate-800 truncate max-w-[250px] md:max-w-full normal-case"
          aria-current="page">{post.title}</span
        >
      </nav>

      <!-- Hero -->
      <div
        class="h-72 md:h-96 bg-slate-900 rounded-3xl overflow-hidden mb-10 flex items-center justify-center relative"
      >
        <img
          src={`/${post.coverImage}`}
          alt={post.title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width="896"
          height="384"
          class="w-full h-full object-cover opacity-60"
          onerror="this.style.display='none'"
        />
        <div
          class="absolute inset-0 bg-linear-to-t from-slate-900/90 via-slate-900/40 to-transparent"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-8 md:p-10">
          <div class="flex flex-wrap gap-2 mb-4">
            {
              post.tags.map((tag) => (
                <span class="bg-blue-600 text-white text-xs font-black px-3 py-1 rounded-full uppercase tracking-wider">
                  {tag}
                </span>
              ))
            }
          </div>
          <h1 class="text-3xl md:text-4xl font-black text-white leading-tight tracking-tight">
            {post.title}
          </h1>
        </div>
      </div>

      <!-- Meta -->
      <div
        class="flex flex-wrap items-center gap-4 text-sm text-slate-500 font-medium mb-10 pb-10 border-b border-slate-200"
      >
        <span class="flex items-center gap-2">
          <span class="w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center shrink-0">
            <svg
              class="w-4 h-4 text-white"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path><circle cx="12" cy="7" r="4"
              ></circle></svg
            >
          </span>
          <span>
            <span class="block font-black text-slate-800 text-sm leading-tight">{post.author}</span>
            <span class="block text-[11px] text-blue-600 font-bold leading-tight"
              >Ex-OEM Engineers · 15+ yrs experience</span
            >
          </span>
        </span>
        <span class="hidden sm:block w-px h-8 bg-slate-200" aria-hidden="true"></span>
        <span class="flex items-center gap-2">
          <svg
            class="w-4 h-4 text-blue-500"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            ><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"
            ></path></svg
          >
          {
            new Date(post.date).toLocaleDateString("en-IN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </span>
        <span class="flex items-center gap-2">
          <svg
            class="w-4 h-4 text-blue-500"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg
          >
          {post.readTime}
        </span>
        <a
          href={linkedinShare}
          target="_blank"
          rel="noopener noreferrer"
          title="Share on LinkedIn"
          class="ml-auto flex items-center gap-2 bg-[#0A66C2] text-white text-xs font-black px-4 py-2 rounded-lg hover:bg-[#004182] transition-all shrink-0"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path></svg
          >
          Share
        </a>
      </div>

      <!-- Content -->
      <div
        id="blog-article-body"
        class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-slate-200 mb-12"
      >
        {
          post.content.map((block) => {
            if (block.type === "h2") {
              return (
                <h2 class="text-2xl md:text-3xl font-black text-slate-900 mt-12 mb-5 tracking-tight first:mt-0">
                  {block.text}
                </h2>
              );
            }
            if (block.type === "p") {
              return (
                <p class="text-slate-700 font-medium text-lg leading-relaxed mb-6">
                  {linkifyBlogText(block.text ?? "", usedLinkGroups, locale).map((part) =>
                    part.href ? (
                      <a
                        href={part.href}
                        class="text-blue-600 font-bold hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-blue-600 rounded"
                      >
                        {part.text}
                      </a>
                    ) : (
                      part.text
                    ),
                  )}
                </p>
              );
            }
            if (block.type === "list") {
              return (
                <ul class="mb-8 space-y-3">
                  {(block.items ?? []).map((item) => (
                    <li class="flex items-start gap-3 text-slate-700 font-medium text-base leading-relaxed">
                      <svg
                        class="w-5 h-5 text-blue-500 shrink-0 mt-0.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>
                        {linkifyBlogText(item, usedLinkGroups, locale).map((part) =>
                          part.href ? (
                            <a
                              href={part.href}
                              class="text-blue-600 font-bold hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-blue-600 rounded"
                            >
                              {part.text}
                            </a>
                          ) : (
                            part.text
                          ),
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              );
            }
            if (block.type === "cta") {
              return (
                <div class="my-10 bg-blue-600 rounded-2xl p-8 flex flex-col sm:flex-row items-center gap-6">
                  <p class="text-white font-bold text-lg leading-relaxed flex-1">{block.text}</p>
                  <a
                    href={waHref(
                      `Hi KESHAV ENTERPRISES, I read your article "${post.title}" and would like to know more.`,
                    )}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 bg-white text-blue-600 px-8 py-4 rounded-xl font-black hover:bg-blue-50 transition-all flex items-center gap-3"
                  >
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                    </svg>
                    WhatsApp Us
                  </a>
                </div>
              );
            }
            return null;
          })
        }
      </div>

      <!-- Share CTA -->
      <div class="bg-slate-900 rounded-2xl p-8 mb-12 flex flex-col sm:flex-row items-center gap-6">
        <div class="flex-1">
          <h3 class="text-xl font-black text-white mb-2">Found this article useful?</h3>
          <p class="text-slate-300 font-medium text-sm">
            Share with your maintenance team or contact us for a technical consultation.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href={linkedinShare}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 bg-[#0A66C2] text-white px-5 py-3.5 rounded-xl font-black text-sm hover:bg-[#004182] transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
            Share on LinkedIn
          </a>
          <a
            href={waHref(
              `Hi KESHAV ENTERPRISES, I read "${post.title}" on your website and would like to discuss.`,
            )}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 bg-whatsapp text-white px-6 py-3.5 rounded-xl font-black text-sm hover:bg-whatsapp-hover transition-all flex items-center gap-3"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path></svg
            >
            Discuss on WhatsApp
          </a>
        </div>
      </div>

      <!-- Explore Our Work strip -->
      <section
        class="bg-[#0A192F] border-t-4 border-blue-600 rounded-2xl overflow-hidden mb-16"
        aria-label="Explore our work"
      >
        <div class="px-8 py-10 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <p class="text-xs font-black text-blue-400 uppercase tracking-[0.25em] mb-1">
              From Our Workshop
            </p>
            <h2 class="text-xl md:text-2xl font-black text-white leading-tight">
              See This Work in Action
            </h2>
            <p class="text-slate-300 text-sm mt-1.5 max-w-sm">
              Real case studies, documented results, and the services behind every job.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href={localizedPath(locale, "/projects")}
              class="bg-blue-600 text-white px-6 py-3.5 rounded-xl font-black text-sm hover:bg-blue-700 transition-all shadow-md flex items-center justify-center gap-2 group"
            >
              Projects &amp; Case Studies
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"
                ></path></svg
              >
            </a>
            <a
              href={localizedPath(locale, "/services")}
              class="border-2 border-slate-600 text-slate-300 px-6 py-3.5 rounded-xl font-black text-sm hover:border-blue-400 hover:text-white transition-all flex items-center justify-center gap-2"
            >
              Our Services
            </a>
          </div>
        </div>
      </section>

      {
        others.length > 0 && (
          <section aria-labelledby="related-posts-heading">
            <h2
              id="related-posts-heading"
              class="text-2xl font-black text-slate-900 mb-6 tracking-tight"
            >
              More Articles
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {others.map((op) => (
                <a
                  href={localizedPath(locale, `/blog/${op.slug}`)}
                  aria-label={`Read post: ${op.title}`}
                  class="bg-white border border-slate-200 rounded-2xl p-7 hover:border-blue-300 hover:shadow-lg hover:-translate-y-0.5 transition-all group block"
                >
                  <div class="flex flex-wrap gap-2 mb-3">
                    {op.tags.slice(0, 2).map((t) => (
                      <span class="bg-slate-100 text-slate-600 text-xs font-black px-2.5 py-1 rounded-full uppercase tracking-wider">
                        {t}
                      </span>
                    ))}
                  </div>
                  <h3 class="text-lg font-black text-slate-900 mb-3 leading-tight group-hover:text-blue-600 transition-colors">
                    {op.title}
                  </h3>
                  <p class="text-slate-500 font-medium text-sm leading-relaxed line-clamp-2 mb-4">
                    {op.excerpt}
                  </p>
                  <span class="text-blue-600 font-bold text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
                    Read Article
                    <svg
                      class="w-4 h-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 12h14m-7-7l7 7-7 7"
                      />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>

---
// src/pages/about.astro
// Full port of AboutPage from App.jsx (line ~16691).
// All navigate() calls → real <a href> links. Static Astro page — no React island needed.
import Layout from "../layouts/Layout.astro";
import { localizedPath } from "../lib/localeMeta";
import {
  OEMS,
  YEARS_IN_BUSINESS,
  FOUNDED_YEAR,
  BUSINESS_OPERATING_YEAR,
  BUSINESS_OPERATING_YEARS,
  ENTITY_FOUNDED_YEAR,
  CONTACT_INFO,
} from "../data/site-config";
import type { Product } from "../data/products";
import { getLocalizedData, getLocalizedList } from "../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const about = getLocalizedData<any>("about", locale);
const PRODUCTS = getLocalizedList<Product>("products", locale);

const ABOUT_SCHEMA = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": "https://www.keshavturbotech.com/about",
  url: "https://www.keshavturbotech.com/about",
  name: about.meta.schemaName,
  description: about.meta.schemaDescriptionTemplate.replace("{years}", String(YEARS_IN_BUSINESS)),
  mainEntity: { "@id": "https://www.keshavturbotech.com/#business" },
};

// Non-text scaffolding only — copy (title/desc/labels) now lives in
// about.json so every locale can carry its own translation; the English
// fallback is guaranteed by getLocalizedData.
const milestones = about.milestones.items;

const values = about.values.items.map((v: any, i: number) => ({
  ...v,
  icon: ["shield", "target", "zap", "users"][i],
}));

const TEAM_META = [
  { key: "sk", initials: "SK", bg: "from-blue-700 to-blue-500", exp: "18+ yrs", oems: ["Triveni", "BHEL", "Maxwatt"] },
  { key: "rk", initials: "RK", bg: "from-slate-700 to-slate-500", exp: "15+ yrs", oems: ["Siemens", "KKK", "ABB"] },
  {
    key: "as",
    initials: "AS",
    bg: "from-cyan-700 to-cyan-500",
    exp: "12+ yrs",
    oems: ["Belliss & Morcom", "Man Turbo", "Chola Turbo"],
  },
  { key: "vp", initials: "VP", bg: "from-indigo-700 to-indigo-500", exp: "10+ yrs", oems: ["All Makes"] },
  { key: "mt", initials: "MT", bg: "from-emerald-700 to-emerald-500", exp: "14+ yrs", oems: ["All Makes"] },
  { key: "pd", initials: "PD", bg: "from-amber-700 to-amber-500", exp: "8+ yrs", oems: ["All Industries"] },
];
const teamMembers = TEAM_META.map((meta) => ({
  ...meta,
  ...about.team.members[meta.key],
}));

const galleryCards = [
  {
    src: "workshop-gallery-1.webp",
    alt: "Keshav Enterprises workshop floor — precision lathes and machining area",
    caption: about.gallery.cards.workshopFloor.caption,
    desc: about.gallery.cards.workshopFloor.desc,
    href: null,
  },
  {
    src: "workshop-gallery-2.webp",
    alt: "Keshav Enterprises engineering services — turbine overhauling, erection, alignment and troubleshooting",
    caption: about.gallery.cards.ourServices.caption,
    desc: about.gallery.cards.ourServices.desc,
    href: localizedPath(locale, "/services"),
    linkLabel: about.gallery.cards.ourServices.linkLabel,
  },
  {
    src: "workshop-gallery-products.webp",
    alt: "Keshav Enterprises industrial product range",
    caption: about.gallery.cards.productRange.caption,
    desc: about.gallery.cards.productRange.descTemplate.replace(
      "{productCount}",
      String(PRODUCTS.length),
    ),
    href: localizedPath(locale, "/products"),
    linkLabel: about.gallery.cards.productRange.linkLabel,
  },
  {
    src: "workshop-gallery-4.webp",
    alt: "Engineer inspecting turbine rotor journal bearing — precision measurement",
    caption: about.gallery.cards.rotorInspection.caption,
    desc: about.gallery.cards.rotorInspection.desc,
    href: null,
  },
];
---

<Layout
  title={about.meta.titleTemplate.replace("{years}", String(YEARS_IN_BUSINESS))}
  description={about.meta.descriptionTemplate.replace("{years}", String(YEARS_IN_BUSINESS))}
  canonicalPath="/about"
  jsonLd={ABOUT_SCHEMA}
>
  <!-- ══ HERO ══ -->
  <div class="bg-[#0A192F] text-white relative overflow-hidden border-b-8 border-blue-600 pt-16">
    <img
      src="/about-story-bg.png"
      alt=""
      aria-hidden="true"
      width="1920"
      height="900"
      loading="eager"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
      style="opacity:0.35;object-fit:cover;"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0 bg-linear-to-r from-[#0A192F]/92 via-[#0A192F]/60 to-[#0A192F]/25">
    </div>
    <div class="absolute inset-0 bg-linear-to-t from-[#0A192F]/80 via-transparent to-[#0A192F]/40">
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-10 pb-24 lg:pt-14 lg:pb-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Left -->
        <div>
          <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-0.5 bg-blue-400 rounded-full" aria-hidden="true"></div>
            <span class="text-blue-400 font-black text-xs uppercase tracking-[0.25em]"
              >{about.hero.eyebrow}</span
            >
          </div>
          <h1 class="text-4xl md:text-6xl font-black text-white leading-none tracking-tight mb-6">
            {about.hero.h1Line1.replace("{years}", String(YEARS_IN_BUSINESS))}<br />
            <span
              class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-cyan-300 to-blue-500"
              >{about.hero.h1Span}</span
            >
          </h1>
          <div class="w-20 h-0.5 bg-blue-500 mb-8 rounded-full" aria-hidden="true"></div>
          <blockquote
            class="bg-white/5 backdrop-blur-md border border-white/10 border-l-4 border-l-blue-500 px-5 py-4 rounded-r-2xl mb-7"
          >
            <p class="text-white text-lg font-bold leading-relaxed italic">
              {about.hero.quote}
            </p>
          </blockquote>
          <p class="text-slate-300 text-base leading-relaxed mb-6">
            {about.hero.intro}
          </p>
          <div class="flex flex-wrap gap-2 mb-10">
            {
              about.hero.tags.map((tag: string) => (
                <span class="bg-white/5 border border-blue-500/30 text-blue-200 text-[11px] font-black uppercase tracking-wider px-3 py-1.5 rounded-full">
                  {tag}
                </span>
              ))
            }
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href={localizedPath(locale, "/services")}
              class="bg-blue-600 text-white px-7 py-3.5 rounded-xl font-black text-sm hover:bg-blue-700 transition-all flex items-center gap-2 group shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 min-h-11"
            >
              {about.hero.ctaServices}
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"
                ></path></svg
              >
            </a>
            <a
              href="/contact"
              class="bg-white/5 text-white border border-white/20 px-7 py-3.5 rounded-xl font-black text-sm hover:bg-white/10 transition-all hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white min-h-11"
            >
              {about.hero.ctaContact}
            </a>
          </div>
        </div>

        <!-- Right stat cards (desktop only) -->
        <div class="hidden lg:grid grid-cols-2 gap-4">
          {
            [
              `${YEARS_IN_BUSINESS}+`,
              "10+",
              "60 MW",
              "24×7",
            ].map((stat, i) => {
              const { label, sub, subTemplate } = about.hero.statCards[i];
              return (
                <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6 hover:-translate-y-1 transition-transform">
                  <div class="text-3xl font-black text-white tracking-tight mb-1">{stat}</div>
                  <div class="text-xs font-black text-blue-300 uppercase tracking-widest mb-1">
                    {label}
                  </div>
                  <div class="text-xs text-slate-500">
                    {subTemplate ? subTemplate.replace("{founded}", String(FOUNDED_YEAR)) : sub}
                  </div>
                </div>
              );
            })
          }
          <div
            class="col-span-2 bg-blue-600/20 border border-blue-500/30 rounded-2xl p-5 flex items-center gap-4"
          >
            <svg
              class="w-8 h-8 text-emerald-400 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
            <div>
              <div class="text-white font-black text-sm">{about.hero.trustBadges.indiamartTitle}</div>
              <div class="text-slate-500 text-xs mt-0.5">{about.hero.trustBadges.indiamartSub}</div>
            </div>
          </div>
          <div
            class="col-span-2 bg-emerald-700/20 border border-emerald-500/30 rounded-2xl p-5 flex items-center gap-4"
          >
            <svg
              class="w-8 h-8 text-emerald-400 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
            >
            <div>
              <div class="text-white font-black text-sm">{about.hero.trustBadges.msmeTitle}</div>
              <div class="text-slate-500 text-xs mt-0.5">
                {about.hero.trustBadges.msmeSub}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="h-1 w-full bg-linear-to-r from-transparent via-blue-500 to-transparent"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- ══ STATS BAR ══ -->
  <div class="bg-blue-600 py-10 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {
          [
            `${YEARS_IN_BUSINESS}+`,
            "10+",
            "60 MW",
            "24×7",
          ].map((stat, i) => {
            const { label, sub, subTemplate } = about.statsBar[i];
            return (
              <div>
                <div class="text-3xl md:text-4xl font-black text-white tracking-tight mb-0.5">
                  {stat}
                </div>
                <div class="text-blue-50 text-xs font-black uppercase tracking-widest mb-0.5">
                  {label}
                </div>
                <div class="text-blue-50 text-xs">
                  {subTemplate ? subTemplate.replace("{founded}", String(FOUNDED_YEAR)) : sub}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <!-- ══ MAIN CONTENT ══ -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Company overview -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start mb-16 lg:mb-24">
      <div>
        <span class="text-blue-600 font-black text-xs uppercase tracking-[0.25em] mb-3 block"
          >{about.overview.eyebrow}</span
        >
        <h2 class="text-4xl font-black text-slate-900 tracking-tight mb-5">
          {about.overview.heading}
        </h2>
        <div class="w-16 h-1 bg-blue-600 mb-6 rounded-full" aria-hidden="true"></div>
        <div class="space-y-4 text-slate-600 text-base leading-relaxed">
          {about.overview.paragraphs.map((p: string) => <p>{p}</p>)}
        </div>
      </div>
      <div class="space-y-5">
        <div class="bg-slate-900 rounded-3xl p-8 text-white">
          <h3 class="font-black text-xl mb-4 tracking-tight">{about.overview.coreCapabilitiesHeading}</h3>
          <ul class="space-y-3">
            {
              about.overview.coreCapabilitiesList.map((item: string) => (
                <li class="flex items-start gap-3 text-slate-300 text-sm leading-relaxed">
                  <svg
                    class="w-4 h-4 text-blue-400 shrink-0 mt-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center shrink-0">
              <svg
                class="w-6 h-6 text-white"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path d="M12 21s-7-7.5-7-12a7 7 0 1114 0c0 4.5-7 12-7 12z"></path><circle
                  cx="12"
                  cy="9"
                  r="2.5"></circle></svg
              >
            </div>
            <div>
              <h3 class="font-black text-slate-900 text-base mb-1">{about.overview.locationHeading}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{CONTACT_INFO.address}</p>
              <p class="text-slate-600 text-xs mt-2 font-bold">{about.overview.gstLabel}: {CONTACT_INFO.gst}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Gallery grid -->
    <div class="mb-24">
      <div class="text-center mb-10">
        <span class="text-blue-600 font-black text-xs uppercase tracking-[0.25em] mb-3 block"
          >{about.gallery.eyebrow}</span
        >
        <h2 class="text-4xl font-black text-slate-900 tracking-tight">
          {about.gallery.headingLine1}<br class="hidden sm:block" /> {about.gallery.headingLine2}
        </h2>
        <div class="w-16 h-1 bg-blue-600 mx-auto mt-4 rounded-full" aria-hidden="true"></div>
        <p class="text-slate-600 text-base max-w-2xl mx-auto mt-5 leading-relaxed">
          {about.gallery.subheadingTemplate.replace("{productCount}", String(PRODUCTS.length))}
        </p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {
          galleryCards.map(({ src, alt, caption, desc, href, linkLabel }) =>
            href ? (
              <a
                href={href}
                class="group relative rounded-2xl overflow-hidden bg-slate-900 border border-slate-200 hover:-translate-y-1 hover:shadow-xl hover:border-blue-400 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 block"
                style="aspect-ratio:4/3"
              >
                <div
                  class="absolute inset-0 flex items-center justify-center bg-slate-900"
                  aria-hidden="true"
                >
                  <div
                    class="absolute inset-0 opacity-20"
                    style="background-image:radial-gradient(circle,#3b82f6 1px,transparent 1px);background-size:20px 20px;"
                  />
                </div>
                <img
                  src={`/${src}`}
                  alt={alt}
                  width="600"
                  height="450"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  onerror="this.style.display='none'"
                />
                <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-slate-900/95 via-slate-900/60 to-transparent px-4 py-4">
                  <p class="text-white font-black text-sm tracking-tight leading-tight mb-1">
                    {caption}
                  </p>
                  <p class="text-slate-300 text-[11px] leading-snug line-clamp-3">{desc}</p>
                  {linkLabel && (
                    <div class="mt-2 flex items-center gap-1 text-blue-400 text-[11px] font-black uppercase tracking-wider">
                      {linkLabel}
                      <svg
                        class="w-3 h-3 group-hover:translate-x-1 transition-transform"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 12h14m-7-7l7 7-7 7"
                        />
                      </svg>
                    </div>
                  )}
                </div>
              </a>
            ) : (
              <div
                class="group relative rounded-2xl overflow-hidden bg-slate-900 border border-slate-200 hover:-translate-y-1 hover:shadow-xl hover:border-slate-400 transition-all"
                style="aspect-ratio:4/3"
              >
                <div
                  class="absolute inset-0 flex items-center justify-center bg-slate-900"
                  aria-hidden="true"
                >
                  <div
                    class="absolute inset-0 opacity-20"
                    style="background-image:radial-gradient(circle,#3b82f6 1px,transparent 1px);background-size:20px 20px;"
                  />
                </div>
                <img
                  src={`/${src}`}
                  alt={alt}
                  width="600"
                  height="450"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  onerror="this.style.display='none'"
                />
                <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-slate-900/95 via-slate-900/60 to-transparent px-4 py-4">
                  <p class="text-white font-black text-sm tracking-tight leading-tight mb-1">
                    {caption}
                  </p>
                  <p class="text-slate-300 text-[11px] leading-snug line-clamp-3">{desc}</p>
                </div>
              </div>
            ),
          )
        }
      </div>
      <div class="text-center mt-10">
        <a
          href={localizedPath(locale, "/products")}
          class="inline-flex items-center gap-2 bg-blue-600 text-white px-8 py-3.5 rounded-xl font-black text-sm hover:bg-blue-700 transition-all shadow-md group focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        >
          {about.gallery.browseFullCatalog}
          <svg
            class="w-4 h-4 group-hover:translate-x-1 transition-transform"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"
            ></path></svg
          >
        </a>
      </div>
    </div>

    <!-- Values -->
    <div class="mb-24">
      <div class="text-center mb-12">
        <span class="text-blue-600 font-black text-xs uppercase tracking-[0.25em] mb-3 block"
          >{about.values.eyebrow}</span
        >
        <h2 class="text-4xl font-black text-slate-900 tracking-tight">{about.values.heading}</h2>
        <div class="w-16 h-1 bg-blue-600 mx-auto mt-4 rounded-full" aria-hidden="true"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-7">
        {
          values.map(
            (
              { label, text }: { label: string; text: string },
              i: number,
            ) => (
              <div class="bg-white border border-slate-200 border-l-4 border-l-slate-300 rounded-r-2xl rounded-l-sm p-7 hover:border-l-blue-600 hover:shadow-xl transition-all group">
                <!--
                  FIX (AI-template audit — Phase 3): this was a centered
                  icon-square-in-a-rounded-card, the single most recognizable
                  "About Us → Our Values" AI-template pattern on the web
                  (identical shape to the pre-fix homepage services grid).
                  Same numbered spec-strip restructure applied there: left
                  accent rule + index number + small inline icon, left-
                  aligned text instead of centered. No icon inventory change
                  needed — same SVGs, smaller and repositioned.
                -->
                <div class="flex items-center gap-3 mb-5">
                  <span
                    class="mono-readout text-xs font-bold text-slate-400 group-hover:text-blue-600 transition-colors"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div class="h-px flex-1 bg-slate-200" aria-hidden="true" />
                  <svg
                    class="w-5 h-5 text-slate-400 group-hover:text-blue-600 transition-colors"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <>
                      <circle cx="12" cy="12" r="10" />
                      <path d="M12 7v5l3 3" />
                    </>
                  </svg>
                </div>
                <h3 class="font-black text-slate-900 text-base mb-3 tracking-tight">{label}</h3>
                <p class="text-slate-600 text-sm leading-relaxed">{text}</p>
              </div>
            ),
          )
        }
      </div>
    </div>

    <!-- Timeline -->
    <div class="mb-24">
      <div class="text-center mb-12">
        <span class="text-blue-600 font-black text-xs uppercase tracking-[0.25em] mb-3 block"
          >{about.milestones.eyebrow}</span
        >
        <h2 class="text-4xl font-black text-slate-900 tracking-tight">{about.milestones.heading}</h2>
        <div class="w-16 h-1 bg-blue-600 mx-auto mt-4 rounded-full" aria-hidden="true"></div>
      </div>
      <div class="relative">
        <div
          class="absolute left-4 md:left-1/2 md:-translate-x-px top-0 bottom-0 w-0.5 bg-linear-to-b from-blue-600 via-blue-400 to-blue-200 rounded-full"
          aria-hidden="true"
        >
        </div>
        <div class="space-y-10">
          {
            milestones.map(({ year, title, desc }: { year: string; title: string; desc: string }, i: number) => (
              <div
                class={`relative flex flex-col md:flex-row gap-8 md:gap-0 ${i % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"}`}
              >
                <div
                  class="absolute left-4 md:left-1/2 -translate-x-1/2 w-4 h-4 bg-blue-600 rounded-full border-4 border-white shadow-md"
                  style="top:1.5rem"
                  aria-hidden="true"
                />
                <div
                  class={`ml-12 md:ml-0 md:w-[45%] ${i % 2 === 0 ? "md:mr-auto md:pr-12" : "md:ml-auto md:pl-12"}`}
                >
                  <div class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-blue-200 hover:shadow-lg transition-all">
                    <span class="text-blue-600 text-2xl font-black block mb-1">{year}</span>
                    <h3 class="font-black text-slate-900 text-lg mb-2 tracking-tight">{title}</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">{desc}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Team -->
    <div class="mb-24">
      <div class="text-center mb-10">
        <span class="text-blue-600 font-black text-xs uppercase tracking-[0.25em] mb-3 block"
          >{about.team.eyebrow}</span
        >
        <h2 class="text-4xl font-black text-slate-900 tracking-tight">
          {about.team.heading}
        </h2>
        <div class="w-16 h-1 bg-blue-600 mx-auto mt-4 rounded-full" aria-hidden="true"></div>
        <p class="text-slate-600 text-base max-w-2xl mx-auto mt-5 leading-relaxed">
          {about.team.subheading}
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          teamMembers.map(({ initials, name, bg, spec, exp, oems }) => (
            <div class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-blue-300 hover:shadow-lg transition-all group">
              <div class="flex items-center gap-4 mb-4">
                <div
                  class={`w-14 h-14 rounded-2xl bg-linear-to-br ${bg} flex items-center justify-center shrink-0 text-white font-black text-lg shadow-md`}
                  aria-hidden="true"
                >
                  {initials}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-black text-slate-900 text-sm leading-tight">{name}</p>
                  <p class="text-blue-600 font-bold text-xs mt-0.5">{exp} {about.team.expSuffix}</p>
                </div>
              </div>
              <p class="text-slate-600 text-xs leading-relaxed mb-3">{spec}</p>
              <div class="flex flex-wrap gap-1.5">
                {oems.map((oem: string) => (
                  <span class="text-[11px] font-black uppercase tracking-wider bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">
                    {oem}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <p class="text-center text-slate-500 text-xs mt-6 font-medium">
        {about.team.namesWithheldNote}
      </p>
    </div>

    <!-- OEM grid -->
    <div
      class="bg-[#0D1F3C] rounded-3xl p-10 md:p-16 text-center mb-24 relative overflow-hidden border border-blue-900/40"
    >
      <div class="relative z-10">
        <span class="text-blue-400 font-black text-xs uppercase tracking-[0.25em] mb-4 block"
          >{about.oemSection.eyebrow}</span
        >
        <h2 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4 leading-tight">
          {about.oemSection.headingLine1}<br />{about.oemSection.headingLine2}
        </h2>
        <p class="text-slate-300 text-base max-w-2xl mx-auto mb-10 leading-relaxed">
          {about.oemSection.sub}
        </p>
        <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto">
          {
            OEMS.map((oem) => (
              <div class="bg-[#152B50] hover:bg-blue-600 border border-blue-800/60 hover:border-blue-400 px-6 py-3 rounded-full transition-all duration-300 hover:-translate-y-0.5">
                <span class="text-white font-black text-sm uppercase tracking-widest whitespace-nowrap">
                  {oem}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Export section -->
    <div class="mb-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-0.5 bg-blue-600 rounded-full" aria-hidden="true"></div>
            <span class="text-blue-600 font-black text-xs uppercase tracking-[0.25em]"
              >{about.exportSection.eyebrow}</span
            >
          </div>
          <h2 class="text-4xl font-black text-slate-900 tracking-tight mb-4 leading-tight">
            {about.exportSection.headingLine1}<br class="hidden sm:block" />
            <span class="text-blue-600">{about.exportSection.headingSpan}</span>
          </h2>
          <div class="w-16 h-1 bg-blue-600 mb-6 rounded-full" aria-hidden="true"></div>
          <div class="space-y-4 text-slate-600 text-base leading-relaxed">
            {about.exportSection.paragraphs.map((p: string) => <p>{p}</p>)}
          </div>
          <div class="mt-7 grid grid-cols-2 gap-4">
            {
              about.exportSection.standards.map(({ stat, label }: { stat: string; label: string }) => (
                <div class="bg-blue-50 border border-blue-100 rounded-xl px-4 py-3">
                  <div class="text-blue-700 font-black text-lg tracking-tight leading-none mb-0.5">
                    {stat}
                  </div>
                  <div class="text-slate-600 text-[11px] font-bold uppercase tracking-wider">
                    {label}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="space-y-5">
          <div class="bg-slate-900 rounded-2xl p-6 flex items-center gap-5">
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center shrink-0 border border-slate-700 bg-pink-50"
            >
              <svg
                class="w-7 h-7 text-pink-700"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line
                  x1="4"
                  y1="22"
                  x2="4"
                  y2="15"></line></svg
              >
            </div>
            <div>
              <h3 class="font-black text-white text-base mb-1">{about.exportSection.iecCardTitle}</h3>
              <p class="text-slate-300 text-sm">
                {about.exportSection.iecCardDescTemplate.split("{iec}")[0]}<span class="font-mono text-slate-400"
                  >{CONTACT_INFO.iec}</span
                >{about.exportSection.iecCardDescTemplate.split("{iec}")[1]}
              </p>
            </div>
          </div>
          <div class="bg-white border border-slate-200 rounded-2xl p-6">
            <h3 class="font-black text-slate-900 text-base mb-4 tracking-tight">
              {about.exportSection.checklistTitle}
            </h3>
            <ul class="space-y-2.5">
              {
                about.exportSection.checklistItems.map((item: string) => (
                  <li class="flex items-start gap-3 text-slate-600 text-sm leading-snug">
                    <svg
                      class="w-4 h-4 text-blue-500 shrink-0 mt-0.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="grid grid-cols-3 gap-3">
            {
              [
                { stat: CONTACT_INFO.gst, label: about.exportSection.credentialLabels.gst },
                { stat: CONTACT_INFO.msme, label: about.exportSection.credentialLabels.msme },
                { stat: CONTACT_INFO.iec, label: about.exportSection.credentialLabels.iec },
              ].map(({ stat, label }) => (
                <div class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-3 text-center">
                  <p class="font-mono text-[9px] text-slate-700 font-bold break-all leading-snug">
                    {stat}
                  </p>
                  <p class="text-[10px] text-slate-500 font-bold uppercase tracking-wider mt-1">
                    {label}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Export Track Record -->
      <div class="mt-10 bg-white border border-slate-200 rounded-2xl p-6 md:p-8">
        <h3 class="font-black text-slate-900 text-lg mb-1 tracking-tight">
          {about.exportSection.trackRecord.heading}
        </h3>
        <p class="text-slate-500 text-sm mb-6">
          {about.exportSection.trackRecord.subheading}
        </p>
        <div class="grid sm:grid-cols-3 gap-3">
          {
            about.exportSection.trackRecord.shipments.map(({ product, country }: { product: string; country: string }) => (
              <div class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-4">
                <p class="font-black text-slate-900 text-sm">{product}</p>
                <p class="text-blue-600 text-xs font-bold uppercase tracking-wider mt-1">→ {country}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Export Trade Terms -->
      <div class="mt-6 bg-white border border-slate-200 rounded-2xl p-6 md:p-8">
        <h3 class="font-black text-slate-900 text-lg mb-1 tracking-tight">
          {about.exportSection.tradeTerms.heading}
        </h3>
        <p class="text-slate-500 text-sm mb-6">
          {about.exportSection.tradeTerms.subheading}
        </p>
        <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-5">
          {
            about.exportSection.tradeTerms.items.map(({ label, value }: { label: string; value: string }) => (
              <div>
                <dt class="text-[11px] font-black text-blue-600 uppercase tracking-widest mb-1">{label}</dt>
                <dd class="text-slate-700 text-sm leading-snug">{value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="text-slate-500 text-xs italic mt-6">{about.exportSection.tradeTerms.note}</p>
      </div>
    </div>
  </div>

  <!-- ══ CTA ══ -->
  <div class="bg-[#0A192F] py-16 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-4">
        {about.finalCta.heading}
      </h2>
      <p class="text-slate-300 font-medium mb-8">
        {about.finalCta.subheading}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="bg-blue-600 text-white px-8 py-4 rounded-xl font-black hover:bg-blue-700 transition-all shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
          >{about.finalCta.ctaQuote}</a
        >
        <a
          href={localizedPath(locale, "/services")}
          class="bg-white/10 text-white border border-white/25 px-8 py-4 rounded-xl font-black hover:bg-white/15 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >{about.finalCta.ctaServices}</a
        >
      </div>
    </div>
  </div>
</Layout>

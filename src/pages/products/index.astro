---
// src/pages/products/index.astro
// Ported from ProductsPage in App.jsx (line ~21663). Hero is static Astro
// markup; the filtering/search/pagination UI is client-only (ProductsGrid
// island) since it's inherently interactive — see that file for why it's one
// island rather than split further.
import Layout from "../../layouts/Layout.astro";
import { localizedPath } from "../../lib/localeMeta";
import ProductsGrid from "../../components/islands/ProductsGrid.jsx";
import CurrencyDropdown from "../../components/islands/CurrencyDropdown.jsx";
import type { Product } from "../../data/products";
import { getLocalizedList, getLocalizedData } from "../../lib/i18n";
import { buildProductImageMap } from "../../lib/productImages";

const locale = Astro.currentLocale ?? "en";

// products.json is keyed by stable product id; product-categories.json is
// keyed by the stable categorySlug (see Phase 2 corrections — filtering
// must key off the slug, never the translatable label). getLocalizedList
// drops object keys, so categories are read via getLocalizedData directly
// and re-paired with their slug.
const products = getLocalizedList<Product>("products", locale);
const categoriesData = getLocalizedData<Record<string, { label: string }>>(
  "product-categories",
  locale,
);
const categories = Object.entries(categoriesData).map(([slug, c]) => ({ slug, label: c.label }));

// Hero title/heading/subheading now come from page-headers.json (new
// namespace — see follow-up item flagged in the Part 1 audit: this page's
// title/h1/subheading were hardcoded English literals even on translated
// locale pages). subheading is a template with {count}/{categories} tokens
// substituted here, same numbers the original hardcoded string computed.
const pageHeaders = getLocalizedData<
  Record<string, { metaTitle: string; metaDescription: string; h1: string; subheading: string }>
>("page-headers", locale).products;
const subheading = pageHeaders.subheading
  .replace("{count}", String(products.length))
  .replace("{categories}", String(categories.length - 1));
const description = subheading;

// ProductsGrid is a client-only island that renders every product, so it
// needs an optimized-URL entry for every image referenced anywhere in the
// catalog. Filenames not yet migrated into src/assets/products/ are simply
// absent from the map — RichProductCard falls back to today's /public path.
const imageMap = await buildProductImageMap(products.flatMap((p) => p.images));
---

<Layout
  title={pageHeaders.metaTitle}
  description={description}
  keywords="turbine spare parts India, lube oil filter elements, HVAC air filters industrial, expansion joints manufacturer, basket strainer, steam trap, turbine blades, OEM compatible spares, Triveni BHEL Siemens spare parts, Keshav Enterprises Shamli"
  canonicalPath="/products"
>
  <!-- ══ HERO ══ -->
  <div
    class="bg-[#0A192F] text-white py-20 mb-12 relative border-b-8 border-blue-600 pt-40"
  >
    <img
      src="/products-hero-bg.webp"
      alt=""
      aria-hidden="true"
      width="1920"
      height="700"
      loading="eager"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
      style="opacity:0.45;object-fit:cover;"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0 bg-[#0A192F]/45"></div>
    <div class="absolute inset-0 bg-linear-to-t from-[#0A192F]/65 via-transparent to-[#0A192F]/20">
    </div>
    <div
      class="absolute inset-0 opacity-10"
      style="background-image:linear-gradient(to right,#4f4f4f2e 1px,transparent 1px),linear-gradient(to bottom,#4f4f4f2e 1px,transparent 1px);background-size:4rem 4rem;"
      aria-hidden="true"
    >
    </div>
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 flex flex-col items-center"
    >
      <h1 class="text-4xl md:text-6xl font-black mb-6 tracking-tight drop-shadow-md">
        {pageHeaders.h1}
      </h1>
      <div class="w-20 h-1.5 bg-blue-500 mb-6 rounded-full" aria-hidden="true"></div>
      <p class="text-slate-300 font-medium max-w-3xl mx-auto text-xl leading-relaxed">
        {subheading}
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
        <span
          class="text-[11px] font-black text-slate-300 uppercase tracking-widest flex items-center gap-1.5"
        >
          <svg
            class="w-3 h-3 text-blue-500"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="10"></circle><path
              d="M2 12h20M12 2a15 15 0 010 20 15 15 0 010-20z"></path></svg
          >
          Export Ready
        </span>
        {
          ["IEC Registered", "HSN Classified", "ISO / API / ASME Compliant"].map((label) => (
            <span class="inline-flex items-center gap-1 bg-white/10 border border-white/15 text-slate-200 text-xs font-semibold px-2.5 py-1 rounded-full">
              {label}
            </span>
          ))
        }
      </div>
      <p class="mt-1.5 text-[11px] text-slate-600 tracking-wide">
        Sea · Air · Courier &nbsp;·&nbsp; Export documentation on request
      </p>
      <!-- FIXED: this was missing entirely — caught via screenshot comparison
           against the live site. The original places exactly one currency
           selector on the whole site, right here in the products hero. -->
      <div class="mt-7 flex justify-center">
        <div
          class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl px-5 py-3"
        >
          <span class="text-slate-300 text-xs font-black uppercase tracking-widest"
            >View prices in</span
          >
          <CurrencyDropdown client:load dark />
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- FIXED: the page went straight from the hero <h1> to each product
         card's <h3> (inside ProductsGrid → RichProductCard), skipping a
         heading level — axe/Lighthouse flags this as invalid heading order.
         RichProductCard is shared across this page, the product detail
         page's "You May Also Need", and Recently Viewed, so its own
         heading level isn't changed (elsewhere it correctly follows a
         visible "You May Also Need" h2). Instead, a single sr-only h2 here
         establishes the missing level for this page specifically — no
         visual change, screen-reader users get an announced section
         landmark instead of an unlabeled jump straight to a product name. -->
    <h2 class="sr-only">Product catalog</h2>
    <ProductsGrid client:load products={products} categories={categories} imageMap={imageMap} locale={locale} />
  </div>

  <!-- ══ CROSS-LINK CTA ══ -->
  <div class="bg-[#0A192F] border-t-4 border-blue-600 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="text-center md:text-left">
          <p class="text-xs font-black text-blue-400 uppercase tracking-[0.25em] mb-2">
            Products Are Only Part of the Picture
          </p>
          <h2 class="text-2xl md:text-3xl font-black text-white leading-tight">
            Need Installation, Overhauling, or a Custom Solution?
          </h2>
          <p class="text-slate-300 text-sm mt-2 max-w-md">
            Our field engineers install, commission, and maintain everything we supply — plus handle
            turbine work, alignment, and balancing that no product alone can fix.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href={localizedPath(locale, "/services")}
            class="bg-blue-600 text-white px-7 py-4 rounded-xl font-black text-sm hover:bg-blue-700 transition-all shadow-lg flex items-center justify-center gap-2 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
          >
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><path
                d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"
              ></path></svg
            >
            Our Engineering Services
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
              ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"
              ></path></svg
            >
          </a>
          <a
            href={localizedPath(locale, "/projects")}
            class="border-2 border-slate-600 text-slate-300 px-7 py-4 rounded-xl font-black text-sm hover:border-blue-400 hover:text-white transition-all flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
          >
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><rect x="2" y="7" width="20" height="14" rx="2"></rect><path
                d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"></path></svg
            >
            Field Case Studies
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
// src/pages/contact.astro
// Ported from ContactPage in App.jsx (line ~24030). The form itself is a
// React island (ContactForm.jsx); everything else here is static Astro markup.
//
// REBUILT: a screenshot-vs-source comparison against App.jsx turned up a lot
// of missing/incorrect content versus the original — wrong hero copy, wrong
// card icons (Icon.astro was literally missing Phone/Mail/MapPin/Clock/
// ExternalLink, so the previous version substituted Wrench/BookOpen/Shield),
// a double-padding bug on the hero banner (same pattern as the homepage —
// see index.astro history), a static Office Hours card with no live status,
// and three entire sections that didn't exist at all: IndiaMART Verified,
// Connect With Us (socials), "Find Us on Google Business", the facility
// photo, and a properly-styled map card (the old version had a bare iframe
// with no header/footer/buttons, misplaced in the left column).
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/islands/ContactForm.jsx";
import ContactOfficeStatus from "../components/islands/ContactOfficeStatus.jsx";
import Icon from "../components/Icon.astro";
import { CONTACT_INFO, SOCIAL_LINKS } from "../data/site-config";
import { getLocalizedData } from "../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const t = getLocalizedData<any>("contact", locale);

const waHref = (text: string) =>
  `https://wa.me/${CONTACT_INFO.whatsapp}?text=${encodeURIComponent(text)}`;

// iconName scaffolding stays here (not text); the label copy comes from
// t.hero.trustSignals, positionally matched to the same three icons as
// the original hardcoded array.
const TRUST_ICONS = ["Shield", "CheckCircle2", "Clock"];
const TRUST_SIGNALS = t.hero.trustSignals.map((text: string, i: number) => ({
  iconName: TRUST_ICONS[i],
  text,
}));

const SITE_URL = "https://www.keshavturbotech.com";
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${SITE_URL}/contact`,
  url: `${SITE_URL}/contact`,
  name: t.meta.schemaName,
  mainEntity: { "@id": `${SITE_URL}/#business` },
};
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  canonicalPath="/contact"
  jsonLd={contactSchema}
>
  <!-- Page-local nav clearance + bg, matching the <main> wrapper the
       original ContactPage renders around itself. Layout.astro's shared
       <main> intentionally carries no padding since different pages clear
       the fixed navbar differently (see index.astro's hero-content-wrap). -->
  <div class="pt-20 pb-20 bg-slate-50 min-h-screen">
    <!-- Hero — matches site-wide dark banner pattern. No pt-16/pt-40 here:
         the outer wrapper above already clears the nav, so this only needs
         its own uniform py-16 like the original. -->
    <div
      class="bg-[#0A192F] text-white py-16 mb-12 relative overflow-hidden border-b-8 border-blue-600"
    >
      <div
        class="absolute inset-0 opacity-10 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-size-[4rem_4rem]"
        aria-hidden="true"
      >
      </div>
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 flex flex-col items-center"
      >
        <h1 class="text-4xl md:text-6xl font-black mb-5 tracking-tight drop-shadow-md">
          {t.hero.title}
        </h1>
        <div class="section-divider w-24 h-1.5 bg-blue-500 mb-6 rounded-full" aria-hidden="true">
        </div>
        <p class="text-slate-300 font-medium max-w-2xl mx-auto text-lg leading-relaxed mb-6">
          {t.hero.subtitle}
        </p>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {
            TRUST_SIGNALS.map(({ iconName, text }) => (
              <div class="flex items-center gap-2 text-slate-400 text-sm font-semibold">
                <Icon name={iconName} class="w-4 h-4 text-blue-400 shrink-0" />
                {text}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mb-16">
        <!-- LEFT: contact info (1 of 3 columns, matching original ratio) -->
        <div class="lg:col-span-1 space-y-6">
          <!-- Direct Lines card -->
          <div
            class="bg-white p-8 border border-slate-200 rounded-3xl shadow-sm flex items-start space-x-5 hover:border-blue-200 transition-colors"
          >
            <div
              class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center shrink-0 border border-blue-100"
            >
              <Icon name="Phone" class="w-7 h-7 text-blue-600" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-black text-slate-900 text-lg mb-2">{t.cards.directLines.title}</h3>
              <div class="space-y-4">
                <div>
                  <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">
                    {t.cards.directLines.salesLabel}
                  </p>
                  <a
                    href={`tel:${CONTACT_INFO.phones[0].replace(/\s/g, "")}`}
                    class="block text-slate-600 font-bold text-base hover:text-blue-600 transition-colors"
                    >{CONTACT_INFO.phones[0]}</a
                  >
                </div>
                <div>
                  <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">
                    {t.cards.directLines.emergencyLabel}
                  </p>
                  <a
                    href={`tel:${CONTACT_INFO.phones[1].replace(/\s/g, "")}`}
                    class="block text-slate-600 font-bold text-base hover:text-blue-600 transition-colors"
                    >{CONTACT_INFO.phones[1]}</a
                  >
                  <a
                    href={waHref(t.cards.directLines.whatsappPrefillMessage)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 mt-1.5 bg-green-50 border border-green-200 text-green-700 text-xs font-black px-2.5 py-1 rounded-full hover:bg-green-100 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-green-400"
                  >
                    <svg
                      class="w-3.5 h-3.5 shrink-0"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      ><path
                        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                      ></path></svg
                    >
                    {t.cards.directLines.whatsappCta}
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Email card -->
          <div
            class="bg-white p-8 border border-slate-200 rounded-3xl shadow-sm flex items-start space-x-5 hover:border-blue-200 transition-colors"
          >
            <div
              class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center shrink-0 border border-blue-100"
            >
              <Icon name="Mail" class="w-7 h-7 text-blue-600" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-black text-slate-900 text-lg mb-2">{t.cards.email.title}</h3>
              <div class="space-y-2">
                {
                  [CONTACT_INFO.email, CONTACT_INFO.infoEmail].map((e) => (
                    <a
                      href={`mailto:${e}`}
                      class="block text-slate-600 font-bold text-sm hover:text-blue-600 transition-colors break-all"
                    >
                      {e}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Facility Address card -->
          <div
            class="bg-white p-8 border border-slate-200 rounded-3xl shadow-sm flex items-start space-x-5 hover:border-blue-200 transition-colors"
          >
            <div
              class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center shrink-0 border border-blue-100"
            >
              <Icon name="MapPin" class="w-7 h-7 text-blue-600" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-black text-slate-900 text-lg mb-2">{t.cards.facilityAddress.title}</h3>
              <p class="text-slate-600 font-bold text-sm leading-relaxed">{CONTACT_INFO.address}</p>
            </div>
          </div>

          <!-- Office Hours card — restored 3rd row (Emergency Line) and the
               live status line (was fully static before) -->
          <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center border border-blue-100 shrink-0"
              >
                <Icon name="Clock" class="w-5 h-5 text-blue-600" />
              </div>
              <h3 class="font-black text-slate-900 text-base">{t.cards.officeHours.title}</h3>
            </div>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between items-center">
                <span class="text-slate-500 font-medium">{t.cards.officeHours.mondaySaturdayLabel}</span>
                <span class="font-black text-slate-900">{t.cards.officeHours.mondaySaturdayValue}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-500 font-medium">{t.cards.officeHours.sundayLabel}</span>
                <span class="font-bold text-slate-500">{t.cards.officeHours.sundayValue}</span>
              </div>
              <div class="flex justify-between items-center pt-2 border-t border-slate-100 mt-1">
                <span class="text-slate-500 font-medium">{t.cards.officeHours.emergencyLineLabel}</span>
                <span class="font-bold text-red-700">{t.cards.officeHours.emergencyLineValue}</span>
              </div>
            </div>
            <ContactOfficeStatus client:load />
          </div>

          <!-- IndiaMART Verified card — was missing entirely -->
          <a
            href={CONTACT_INFO.indiamart}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.cards.indiamart.ariaLabel}
            class="bg-slate-900 p-8 border border-slate-800 rounded-3xl shadow-lg flex items-start space-x-5 hover:border-blue-500 transition-colors group w-full"
          >
            <div
              class="w-14 h-14 bg-slate-800 rounded-2xl flex items-center justify-center shrink-0 border border-slate-700 group-hover:border-blue-500/50 transition-colors"
            >
              <Icon name="CheckCircle2" class="w-7 h-7 text-emerald-400" />
            </div>
            <div>
              <h3 class="font-black text-white text-lg mb-1">{t.cards.indiamart.title}</h3>
              <p class="text-yellow-400 font-bold text-sm mb-1.5">
                <span class="sr-only">{t.cards.indiamart.ratingSrOnly}</span>
                <span aria-hidden="true">★★★★★</span>
                <span class="text-slate-300 ml-1">{t.cards.indiamart.ratingText}</span>
              </p>
              <p class="text-blue-400 font-black text-xs uppercase tracking-widest">
                {t.cards.indiamart.trustSeal}
              </p>
            </div>
          </a>

          <!-- Connect With Us — was missing entirely -->
          <div class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
            <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-3">
              {t.cards.connect.label}
            </p>
            <div class="flex flex-wrap gap-2">
              {
                SOCIAL_LINKS.map(({ href, label, handle, color, path }) => (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={label}
                    class="connect-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-bold text-slate-600 bg-white hover:text-slate-900 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                    style={`--pc:${color}; border-color:color-mix(in srgb, var(--pc) 40%, transparent);`}
                  >
                    <span style={`color:${color}; display:flex;`}>
                      <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d={path} />
                      </svg>
                    </span>
                    {handle}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- RIGHT: form + supporting cards (2 of 3 columns) -->
        <div class="lg:col-span-2">
          <div
            class="bg-white p-8 md:p-12 border border-slate-200 rounded-3xl shadow-xl shadow-slate-200/50"
          >
            <div class="flex flex-col mb-8 border-b border-slate-100 pb-6">
              <h2 class="text-3xl font-black text-slate-900 tracking-tight">
                {t.formSection.heading}
              </h2>
              <p class="text-slate-600 font-medium text-sm mt-2">
                {t.formSection.subheading}
              </p>
            </div>
            <ContactForm client:load content={t.form} />
          </div>
        </div>
      </div>

      <!-- Full-width row below the grid — matches the original React layout,
           where these three cards span the entire max-w-7xl container rather
           than being squeezed into the 2/3-width form column (that was a bug
           in a previous version of this file). -->
      <div class="mt-12 space-y-6">
        <!-- Google Business CTA card — was missing entirely -->
        <div
          class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-col sm:flex-row items-center gap-5 shadow-sm"
        >
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 border border-slate-100"
            style="background-color:#e8f0fe"
          >
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                fill="#4285F4"></path>
              <path
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                fill="#34A853"></path>
              <path
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                fill="#FBBC05"></path>
              <path
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                fill="#EA4335"></path>
            </svg>
          </div>
          <div class="flex-1 text-center sm:text-left">
            <h3 class="font-black text-slate-900 text-lg mb-1">{t.googleBusiness.title}</h3>
            <p class="text-slate-600 font-medium text-sm leading-relaxed">
              {t.googleBusiness.descriptionPrefix} <strong class="text-slate-700">&ldquo;{t.googleBusiness.descriptionQuoted}&rdquo;</strong> {t.googleBusiness.descriptionSuffix}
            </p>
          </div>
          <a
            href={CONTACT_INFO.googleBusiness}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 bg-[#4285F4] text-white px-6 py-3 rounded-xl font-black text-sm hover:bg-[#3367d6] transition-all shadow-md flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-11"
          >
            <Icon name="ExternalLink" class="w-4 h-4" /> {t.googleBusiness.cta}
          </a>
        </div>

        <!-- Facility photo — was missing entirely. Collapses gracefully
                 if the image isn't uploaded (matching the original's
                 onLoad/onError reveal pattern; no React needed for this). -->
        <div
          id="facility-photo-wrapper"
          class="bg-slate-900 rounded-3xl overflow-hidden border border-slate-800 shadow-xl hidden"
        >
          <img
            src="/contact-facility.webp"
            alt={t.facilityPhoto.alt}
            loading="lazy"
            decoding="async"
            width="1200"
            height="480"
            class="w-full object-cover"
            style="max-height:320px"
            onload="this.closest('#facility-photo-wrapper').classList.remove('hidden')"
            onerror="this.closest('#facility-photo-wrapper').classList.add('hidden')"
          />
          <div class="px-6 py-3 flex items-center gap-2 border-t border-slate-800 bg-slate-900">
            <Icon name="Factory" class="w-4 h-4 text-blue-400 shrink-0" />
            <p class="text-slate-300 text-sm font-bold">{t.facilityPhoto.caption}</p>
          </div>
        </div>

        <!-- Embedded Google Map — rebuilt with header/footer/buttons,
                 previously a bare unstyled iframe misplaced in the left
                 column with none of this. -->
        <div class="bg-white border border-slate-200 rounded-3xl shadow-xl overflow-hidden">
          <div class="flex items-center gap-3 px-6 py-4 border-b border-slate-100">
            <Icon name="MapPin" class="w-5 h-5 text-blue-600 shrink-0" />
            <h2 class="font-black text-slate-900 text-lg tracking-tight">
              {t.map.heading}
            </h2>
          </div>
          <div class="relative h-64 bg-slate-100">
            <div
              class="map-skeleton absolute inset-0 flex items-center justify-center bg-slate-100 animate-pulse"
            >
              <Icon name="MapPin" class="w-8 h-8 text-slate-300" />
            </div>
            <iframe
              title={t.map.iframeTitle}
              src={CONTACT_INFO.googleMapsEmbed}
              width="100%"
              height="100%"
              style="border:0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="relative z-10"
              onload="this.previousElementSibling.style.display='none'"></iframe>
          </div>
          <div
            class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3"
          >
            <p class="text-slate-600 font-medium text-sm">{CONTACT_INFO.address}</p>
            <div class="flex gap-3 shrink-0 flex-wrap justify-center sm:justify-end">
              <a
                href={CONTACT_INFO.googleBusiness}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-[#4285F4] text-white px-5 py-2.5 rounded-xl font-black text-sm hover:bg-[#3367d6] transition-all flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-11"
              >
                <Icon name="ExternalLink" class="w-4 h-4" /> {t.map.googleBusinessCta}
              </a>
              <a
                href={CONTACT_INFO.gmapsShare}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-blue-600 text-white px-5 py-2.5 rounded-xl font-black text-sm hover:bg-blue-700 transition-all flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-11"
              >
                <Icon name="MapPin" class="w-4 h-4" /> {t.map.directionsCta}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Matches the original's onMouseEnter/onMouseLeave inline-style tint
       (bg ${color}12, border ${color}70) using CSS color-mix instead of JS. */
    .connect-pill:hover {
      background: color-mix(in srgb, var(--pc) 12%, white);
      border-color: color-mix(in srgb, var(--pc) 70%, transparent);
    }
  </style>
</Layout>

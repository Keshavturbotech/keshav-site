      </a>
    </div>
  </div>

  <!--
    FIXED: this was a single simple centered CTA box — caught during the
    same audit. The real final CTA (App.jsx line ~16563) is a "two-path"
    design addressing both visitor types separately (planned work vs.
    emergency breakdown), plus a 4-item risk-reversal strip below.
  -->
  <section class="bg-[#0A192F] py-20" aria-labelledby="cta-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 id="cta-heading" class="text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
          {home.finalCta.heading}
        </h2>
        <p class="text-slate-300 font-medium text-lg max-w-2xl mx-auto">
          {home.finalCta.subheading}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <!-- Path 1 — Planned work -->
        <div
          class="bg-white/5 border border-white/10 rounded-2xl p-8 hover:border-blue-400/40 transition-all"
        >
          <div
            class="w-12 h-12 bg-blue-600/20 rounded-xl flex items-center justify-center mb-5 border border-blue-500/30"
          >
            <svg
              class="w-6 h-6 text-blue-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="3"></circle><path
                d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"
              ></path></svg
            >
          </div>
          <h3 class="text-xl font-black text-white mb-3">{home.finalCta.plannedTitle}</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            {home.finalCta.plannedDesc}
          </p>
          <div class="flex flex-col gap-3">
            <a
              href="/contact"
              class="w-full bg-blue-600 text-white px-6 py-3.5 rounded-xl font-black text-sm hover:bg-blue-700 transition-all flex items-center justify-center gap-2 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
            >
              {home.finalCta.plannedSendBtn}
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"
                ></path></svg
              >
            </a>
            <a
              href={`mailto:${CONTACT_INFO.infoEmail}`}
              class="w-full bg-white/5 text-slate-300 border border-white/10 px-6 py-3.5 rounded-xl font-bold text-sm hover:bg-white/10 transition-all flex items-center justify-center gap-2"
            >
              <svg
                class="w-4 h-4 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M22 6l-10 7L2 6"
                ></path></svg
              >
              {home.finalCta.plannedEmailBtn}
            </a>
          </div>
        </div>

        <!-- Path 2 — Emergency -->
        <div
          class="bg-white/5 border border-red-500/20 rounded-2xl p-8 hover:border-red-400/40 transition-all"
        >
          <div
            class="w-12 h-12 bg-red-500/10 rounded-xl flex items-center justify-center mb-5 border border-red-500/20"
          >
            <svg
              class="w-6 h-6 text-red-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><path d="M12 2a10 10 0 100 20 10 10 0 000-20zM12 8v5m0 3h.01"></path></svg
            >
          </div>
          <h3 class="text-xl font-black text-white mb-3">{home.finalCta.emergencyTitle}</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            {home.finalCta.emergencyDesc}
          </p>
          <div class="flex flex-col gap-3">
            <a
              href={`tel:${CONTACT_INFO.phones[1].replace(/\s/g, "")}`}
              class="w-full bg-red-600 text-white px-6 py-3.5 rounded-xl font-black text-sm hover:bg-red-500 transition-all flex items-center justify-center gap-2"
            >
              <svg
                class="w-4 h-4 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path
                  d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"
                ></path></svg
              >
              {home.finalCta.emergencyCallPrefix} {CONTACT_INFO.phones[1]}
            </a>
            <a
              href={waEmergency}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-whatsapp text-white px-6 py-3.5 rounded-xl font-black text-sm hover:bg-whatsapp-hover transition-all flex items-center justify-center gap-2"
            >
              <svg
                class="w-4 h-4 shrink-0"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                ><path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                ></path></svg
              >
              {home.finalCta.emergencyWhatsappBtn}
            </a>
          </div>
        </div>
      </div>

      <!-- Risk-reversal strip -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-10">
        {
          [
            {
              text: home.finalCta.riskReversal[0],
              iconPath: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
            },
            {
              text: home.finalCta.riskReversal[1],
              iconPath: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
            },
            {
              text: home.finalCta.riskReversal[2],
              iconPath: "M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z",
            },
            {
              text: home.finalCta.riskReversal[3],
              iconPath: "M12 22a10 10 0 100-20 10 10 0 000 20zM12 6v6l4 2",
            },
          ].map((item) => (
            // text-slate-500 measured 3.69:1 on this section's #0A192F
            // background (fails WCAG AA 4.5:1) — text-slate-400 clears it
            <div class="flex items-start gap-2.5 text-slate-400 text-sm font-medium">
              <svg
                class="w-4 h-4 text-blue-400 shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d={item.iconPath} />
              </svg>
              <span>{item.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .ke-marquee {
    display: flex;
    width: max-content;
    animation: ke-scroll 40s linear infinite;
  }
  /*
    FIX (UX audit — auto-moving content needs a pause): the marquee has no
    visible pause control for sighted users, which matters for anyone with
    vestibular or attention sensitivities even though the row is decorative
    (aria-hidden) and already skipped correctly by screen readers.
    Pausing on hover/focus-within gives a low-effort way to stop the motion
    without adding a new UI control.
  */
  .ke-marquee-pausable:hover .ke-marquee,
  .ke-marquee-pausable:focus-within .ke-marquee {
    animation-play-state: paused;
  }
  @keyframes ke-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ke-marquee {
      animation: none;
    }
  }
</style>

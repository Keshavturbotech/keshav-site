---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { localizedPath } from "../lib/localeMeta";
import StatNum from "../components/islands/StatNum.jsx";
import OfficeHoursPill from "../components/islands/OfficeHoursPill.jsx";
import FeaturedProductsStrip from "../components/islands/FeaturedProductsStrip.jsx";
import {
  OEMS,
  YEARS_IN_BUSINESS,
  FOUNDED_YEAR,
  BUSINESS_OPERATING_YEAR,
  BUSINESS_OPERATING_YEARS,
  CONTACT_INFO,
} from "../data/site-config";
import Icon from "../components/Icon.astro";
import { SERVICE_ICON_NAMES } from "../data/services";
import { buildProductImageMap, hasLocalImage } from "../lib/productImages";
import type { Product } from "../data/products";
import type { Service } from "../data/services";
import type { CaseStudy } from "../data/case-studies";
import { getLocalizedData, getLocalizedList } from "../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const home = getLocalizedData<any>("home", locale);
const SERVICES = getLocalizedList<Service>("services", locale);
const PRODUCTS = getLocalizedList<Product>("products", locale);
const CASE_STUDIES = getLocalizedList<CaseStudy>("case-studies", locale);

// Deterministic featured selection: highest-demand products across all 10
// categories, expanded from 8 to 18 (see FeaturedProductsStrip.jsx — it's a
// scrolling carousel with lazy-loaded images, so more cards has no real
// performance cost; this list is sized for UX/curation, not perf).
// Stable across builds (no random) = consistent HTML for CDN caching & SEO.
//
// Photo-aware: while the 1,584-photo migration is in progress, most of these
// curated picks won't have a real photo yet (checked against both
// src/assets/products/ and public/, wherever the file currently lives) and
// would show the plain category icon instead. Rather than that, each slot
// falls back to the first other product in the *same category* that does
// have a real photo — same category diversity, but a real image whenever
// one exists anywhere in that category. If literally nothing in a category
// has a photo yet, the original curated pick is kept (icon fallback, same
// as today). No manual FEATURED_IDS edits needed as more photos land.
const CURATED_FEATURED_IDS = [
  // Turbine Spares — core specialty, high-turnover wear parts
  "prod_ts1", // Carbon & Graphite Gland Sealing Rings
  "prod_ts3", // Babbitt Journal Bearings & Thrust Pads
  "prod_ts2", // Labyrinth Shaft Sealing Packings
  // Industrial Filtration — recurring replacement-element demand
  "prod_f1", // Triveni Replacement Turbine Lube Oil Filter Elements
  "prod_f2", // Siemens Replacement Turbine Lube Oil Filter Elements
  "prod_f20", // HYDAC Replacement Filter Elements
  // Valves, Gaskets & Steam System Products
  "prod_gk1", // Spiral Wound Gaskets (SWG): ASME B16.20
  "prod_trap1", // Steam Trap Assemblies: Thermodynamic & Float Type
  // Industrial Strainers
  "prod_st1", // Simplex Basket Strainer
  "prod_st2", // Duplex Basket Strainer
  // Expansion Joints
  "prod_e1", // Stainless Steel Metallic Bellows Expansion Joint
  "prod_e2", // Double Arch Rubber Expansion Joint
  // Flexible Hoses & Assemblies
  "prod_h1", // SS Corrugated Flexible Metal Hose Assemblies
  "prod_h3", // High-Pressure Hydraulic Rubber Hose Assemblies
  // Industrial Rubber Products
  "prod_r1", // Custom Extruded Rubber Profiles & Seals
  // Electronic Equipments
  "prod_ee1", // Vibration Monitoring Probes (Shinkawa-compatible)
  // Hydraulic Components
  "prod_hv1", // Directional Control Valves (All Major Makes)
  // HVAC, Ducting & Air Filtration
  "prod_af1", // HVAC Pocket Bag Filter (Multi-Pocket Air Filter)
];
const usedIds = new Set<string>();
const FEATURED_PRODUCTS = CURATED_FEATURED_IDS.map((id) => {
  const curated = PRODUCTS.find((p) => p.id === id);
  if (!curated) return null;
  if (hasLocalImage(curated.images?.[0])) {
    usedIds.add(curated.id);
    return curated;
  }
  const replacement = PRODUCTS.find(
    (p) =>
      p.categorySlug === curated.categorySlug && !usedIds.has(p.id) && hasLocalImage(p.images?.[0]),
  );
  usedIds.add((replacement ?? curated).id);
  return replacement ?? curated;
}).filter(Boolean) as typeof PRODUCTS;
const featuredImageMap = await buildProductImageMap(FEATURED_PRODUCTS.flatMap((p) => p.images));

// Service "pain line" italic teasers only exist for the 3 services featured
// on the homepage (srv_2/srv_3/srv_4) — copy now lives in home.json so it's
// translatable per locale; English fallback still guaranteed via getLocalizedData.
const SERVICE_PAIN_LINES: Record<string, string> = home.servicesPreview.painLines;

// Copy lives in home.json now; only the non-text bits (icon paths / stat
// numbers) stay here, keyed the same way so they zip together below.
const TESTIMONIALS = home.testimonials.items;
const CAPABILITIES_META = [
  { iconName: "Zap" },
  { iconName: "Layers" },
  { iconName: "Activity" },
  { iconName: "Wind" },
  { iconName: "Droplets" },
  { iconName: "Cpu" },
];
const CAPABILITIES = CAPABILITIES_META.map((meta, i) => ({
  ...meta,
  text: home.capabilities.items[i].text,
}));

const description = home.meta.description;
const keywords = home.meta.keywords;

const HOME_STATS = [
  {
    iconPath: "M3 17l6-6 4 4 8-8M21 7v6m0-6h-6",
    end: 500,
    suffix: "+",
    label: home.stats.overhauls.label,
    sub: home.stats.overhauls.sub,
  },
  {
    iconPath: "M12 8v4l3 3M12 22a10 10 0 100-20 10 10 0 000 20z",
    end: YEARS_IN_BUSINESS,
    suffix: "+",
    label: home.stats.years.label,
    sub: home.stats.years.sub.replace("{founded}", String(FOUNDED_YEAR)),
  },
  {
    iconPath: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
    end: 0,
    suffix: "",
    label: home.stats.penaltyClaims.label,
    sub: home.stats.penaltyClaims.sub.replace("{businessYears}", String(BUSINESS_OPERATING_YEARS)),
  },
  {
    iconPath:
      "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m9-5.13a4 4 0 11-8 0 4 4 0 018 0z",
    end: null,
    suffix: "24×7",
    label: home.stats.emergency.label,
    sub: home.stats.emergency.sub,
  },
];

const waEmergency = `https://wa.me/${CONTACT_INFO.whatsapp}?text=${encodeURIComponent(home.whatsappEmergencyMessage)}`;
---

<Layout title={home.meta.title} description={description} keywords={keywords} canonicalPath="/">
  <!-- ══ HERO ══ -->
  <section
    class="relative bg-[#0A192F] flex lg:items-stretch justify-center overflow-hidden"
    aria-label="Hero — Precision Engineering for Maximum Uptime"
  >
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <img
        src="/hero-background.webp"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        sizes="100vw"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div
        class="absolute inset-0"
        style="background:radial-gradient(ellipse at center,rgba(10,25,47,0.30) 0%,rgba(10,25,47,0.55) 70%,rgba(10,25,47,0.78) 100%)"
      >
      </div>
      <!--
        FIX (AI-template audit — Phase 2, corrected): the original build
        this shipped in DOES include a real photo here (hero-background.webp)
        — not in the zip handed to Claude, so the earlier "no strong visual
        content" note was wrong on its premise and is retracted. The actual
        issue is that the photo was being darkened by ~35%→92% opacity
        (center→edge) PLUS this top-fade PLUS the blueprint texture above —
        stacked enough that a real, differentiating photo was reading as
        generic dark texture, same visual result as having no photo at all.
        Two changes: (1) the radial above is eased to 30%→78% so more of the
        image survives everywhere; (2) this lg+-only left-to-right gradient
        replaces relying on the radial alone for text contrast — it keeps
        the LEFT column (where the H1/CTA sit) dark enough to protect the
        contrast ratio already validated for this page, while leaving the
        RIGHT column (proof cards) far lighter so the real photo shows
        clearly behind the glass cards instead of behind another scrim.
        NEEDS A VISUAL QA PASS against the actual photo — these opacities
        are a reasoned starting point, not verified against the real image,
        since it wasn't available to check against here.
      -->
      <div
        class="hidden lg:block absolute inset-0 bg-linear-to-r from-[#0A192F]/80 via-[#0A192F]/45 to-[#0A192F]/10"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute inset-0 bg-linear-to-t from-[#0A192F]/80 via-transparent to-transparent z-10"
      >
      </div>
      <!--
        FIX (AI-template audit): removed the two blurred color-orb divs
        (bg-blue-600/30 + bg-cyan-600/20, both blur-[128px]) that previously
        sat here — see global.css .hero-blueprint-overlay comment for why.
      -->
      <div class="absolute inset-0 hero-blueprint-overlay z-[1]" aria-hidden="true"></div>
    </div>

    <div
      class="hero-content-wrap max-w-7xl mx-auto w-full relative z-30 flex flex-col lg:flex-row items-stretch lg:items-start justify-center lg:justify-between gap-8 lg:gap-10"
    >
      <!-- LEFT COLUMN -->
      <div class="w-full flex-1 lg:h-auto lg:w-3/5 flex flex-col">
        <div class="flex flex-col flex-1">
          <!--
            FIX (UX audit — hero badge hierarchy): the IndiaMART rating badge
            previously sat here at the SAME size/weight as Make In India,
            directly competing with the H1 for first-glance attention.
            Only one badge remains at this weight; the IndiaMART rating is
            now a compact pill in the trust strip below the CTAs, where it
            sits alongside the other quantified trust signals instead of
            racing the headline for eyes.
          -->
          <div class="flex flex-wrap gap-3 mb-4 justify-center lg:justify-start">
            <div
              class="inline-flex items-center space-x-3 bg-white/5 backdrop-blur-sm px-4 py-2 rounded-md border border-white/20 shadow-xl"
              role="img"
              aria-label="Make In India — Vocal For Local"
            >
              <img
                src="/make-in-india.png"
                alt=""
                aria-hidden="true"
                width="32"
                height="32"
                loading="eager"
                decoding="async"
                class="w-8 h-8 object-contain shrink-0"
              />
              <div class="flex flex-col justify-center border-l border-white/20 pl-3">
                <span class="text-white font-black text-sm leading-none uppercase tracking-widest"
                  >{home.hero.badgeMakeInIndia}</span
                >
                <span
                  class="text-white text-[11px] font-extrabold leading-none uppercase tracking-wider mt-1"
                  >{home.hero.badgeVocalForLocal}</span
                >
              </div>
            </div>
          </div>

          <h1
            id="hero-heading"
            class="hero-h1 font-black tracking-tight mb-4 text-center lg:text-left"
          >
            <span class="hero-h1-line1">{home.hero.h1Line1}</span>
            <span class="hero-gradient-text bg-linear-to-r from-blue-400 via-cyan-300 to-blue-500"
              >{home.hero.h1Line2}</span
            >
          </h1>

          {home.hero.capabilityLine && (
            <p
              class="text-cyan-300 font-bold text-center lg:text-left text-base sm:text-lg mb-6 tracking-tight"
            >
              {home.hero.capabilityLine}
            </p>
          )}

          <div class="flex flex-col flex-1 lg:justify-between lg:gap-6">
            <div
              class="mx-auto lg:mx-0 lg:order-1 mb-6 lg:mb-0 max-w-xl bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-5"
            >
              <p class="text-slate-200 font-medium leading-relaxed text-center lg:text-left">
                {home.hero.introText.replace("{businessSince}", String(BUSINESS_OPERATING_YEAR))}
              </p>
            </div>

            <!--
              Mobile DOM order: CTAs, then trust strip + pill (no reordering).
              Desktop order via lg:order-*: trust strip + pill (lg:order-2)
              appears BEFORE CTAs (lg:order-3) — matches the client's
              reference screenshot, which shows the CTA row living under the
              trust strip in the LEFT column at every breakpoint (this row
              used to be lg:hidden with a full-width duplicate rendered in
              the right column instead — removed below to avoid showing the
              buttons twice).
            -->
            <div class="flex flex-col gap-4 lg:contents">
              <div
                class="flex flex-col sm:flex-row gap-4 sm:gap-5 justify-center lg:justify-start lg:order-3"
              >
                <a
                  href="/contact"
                  class="flex-1 sm:flex-none bg-blue-600 text-white font-black rounded-xl hover:bg-blue-700 transition-all flex items-center justify-center gap-2.5 shadow-lg shadow-black/30 hover:shadow-xl hover:shadow-black/40 tracking-tight hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 whitespace-nowrap px-6 py-4 text-sm"
                >
                  {home.hero.ctaPrimary}
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                    ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"
                    ></path></svg
                  >
                </a>
                <!--
                  DESIGN AUDIT NOTE: currently styled as the secondary/glass
                  CTA (translucent bg-white/8), matching WhatsApp fallback
                  styling elsewhere. However, HOME_STATS below treats 24x7
                  emergency response as one of exactly four headline
                  differentiators, co-equal with years-in-business and
                  overhaul count — meaning it may be a genuine core value
                  prop rather than a secondary/nice-to-have action.
                  Confirm with the business owner whether this CTA should
                  be visually promoted (e.g. an amber/orange solid fill
                  distinct from the primary blue) before changing its
                  styling — this is a business-priority call, not a pure
                  design fix.
                -->
                <a
                  href={waEmergency}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 sm:flex-none bg-white/8 text-white border border-white/25 font-bold rounded-xl hover:bg-white/15 transition-all flex items-center justify-center gap-2.5 backdrop-blur-md hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 whitespace-nowrap px-6 py-4 text-sm"
                >
                  <svg
                    class="text-cyan-400 shrink-0"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                    ><circle cx="12" cy="12" r="10"></circle><path
                      d="M4.9 4.9l4.2 4.2m5.8 5.8l4.2 4.2M4.9 19.1l4.2-4.2m5.8-5.8l4.2-4.2"
                    ></path></svg
                  >
                  {home.hero.ctaEmergency}
                </a>
              </div>

              <div class="flex flex-col gap-3 lg:order-2">
                <div
                  class="flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-2"
                >
                  <div class="flex items-center gap-2 text-slate-300 text-sm font-bold">
                    <svg
                      class="w-4 h-4 text-cyan-400 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      aria-hidden="true"
                      ><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"
                      ></path></svg
                    >
                    <span
                      >{home.hero.trustYearsOverhauls.replace(
                        "{years}",
                        String(YEARS_IN_BUSINESS),
                      )}</span
                    >
                  </div>
                  <div class="flex items-center gap-2 text-slate-300 text-sm font-bold">
                    <!--
                      FIX (AI-template audit — accent hierarchy): this and
                      the IndiaMART rating below are verifiable/technical
                      claims, not calls-to-action, so they now use
                      --color-signal (amber) instead of the same cyan/blue
                      used for the CTA buttons above. Keeps "click this" and
                      "this is certified" visually distinct. See global.css.
                    -->
                    <svg
                      class="w-4 h-4 text-signal-light shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                      ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
                    >
                    <span>{home.hero.trustPmi}</span>
                  </div>
                  <div class="flex items-center gap-2 text-slate-300 text-sm font-bold">
                    <svg
                      class="w-4 h-4 text-cyan-400 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"></path></svg
                    >
                    <span>{home.hero.trustResponse}</span>
                  </div>
                  <a
                    href={CONTACT_INFO.indiamart}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-slate-300 text-sm font-bold hover:text-white transition-colors"
                  >
                    <span
                      role="img"
                      class="text-signal-light text-xs tracking-widest"
                      aria-label="4.3 out of 5 stars"
                    >
                      ★★★★★
                    </span>
                    <span
                      >{home.hero.badgeIndiaMartLabel} 4.3/5 {
                        home.hero.badgeIndiaMartRatingSuffix
                      }</span
                    >
                  </a>
                </div>
                <OfficeHoursPill client:load />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN — proof cards, desktop only -->
      <div class="w-full lg:w-2/5 hidden lg:flex flex-col gap-5 lg:mt-10">
        {
          [
            {
              ...home.hero.proofCards[0],
              ml: "",
              iconPath: "M12 15a4 4 0 100-8 4 4 0 000 8zM8.21 13.89L7 23l5-3 5 3-1.21-9.12",
            },
            {
              ...home.hero.proofCards[1],
              ml: "ml-10",
              iconPath: "M22 11.08V12a10 10 0 11-5.93-9.14M22 4L12 14.01l-3-3",
            },
            {
              ...home.hero.proofCards[2],
              ml: "ml-3",
              iconPath:
                "M15.05 5A5 5 0 0119 8.95M15.05 1A9 9 0 0123 8.94m-1 7.98v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z",
            },
          ].map((card) => (
            <div
              class={`bg-linear-to-br from-[#0A192F]/80 to-slate-900/80 backdrop-blur-xl border border-white/10 p-6 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] hover:border-blue-400/40 hover:-translate-y-2 transition-all ${card.ml}`}
            >
              <div class="flex justify-between items-start mb-3">
                <div class="text-blue-300 text-xs font-black uppercase tracking-widest">
                  {card.label}
                </div>
                <svg
                  class="w-5 h-5 text-blue-400 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d={card.iconPath} />
                </svg>
              </div>
              <div class="text-2xl font-black text-white tracking-tighter mb-2">{card.title}</div>
              <div class="text-sm text-slate-500 font-medium leading-relaxed">{card.sub}</div>
            </div>
          ))
        }

        <!--
          Desktop-only duplicate of the CTA buttons removed per client
          feedback (reference screenshot): the buttons now live only in the
          left column's compact row (visible at every breakpoint via
          lg:order-3 above), directly under the trust strip, instead of a
          second full-width copy stacked below these proof cards.
        -->
      </div>
    </div>
  </section>

  <!-- ══ OEM MARQUEE ══ -->
  <!--
    FIXED: this previously rendered plain text names only — caught via
    screenshot comparison, which shows the real site loads actual OEM logo
    images (e.g. /siemens-logo.png) and only falls back to text+icon if that
    image 404s (App.jsx line ~16026). Restored the same onError fallback
    pattern here using inline onerror (Astro renders static markup, no
    React state available for a display-toggle the way the original did it).
  -->
  <section
    class="bg-white py-14 md:py-20 border-b border-slate-100 overflow-hidden border-t-4 border-t-[#0A192F]"
    aria-label="OEM-compatible brands"
  >
    <div class="max-w-7xl mx-auto px-4 mb-8">
      <p class="text-center text-sm font-black text-slate-600 uppercase tracking-widest">
        {home.oemMarquee.heading}
      </p>
    </div>
    <div
      class="ke-marquee-pausable relative w-full overflow-hidden flex items-center"
      aria-hidden="true"
    >
      <div
        class="absolute left-0 top-0 w-24 md:w-48 h-full bg-linear-to-r from-white to-transparent z-10 pointer-events-none"
      >
      </div>
      <div
        class="absolute right-0 top-0 w-24 md:w-48 h-full bg-linear-to-l from-white to-transparent z-10 pointer-events-none"
      >
      </div>
      <div class="ke-marquee gap-8 md:gap-16 px-4">
        {
          [...OEMS, ...OEMS].map((oem) => {
            const slug = oem.toLowerCase().replace(/[^a-z0-9]/g, "-");
            return (
              <div class="flex items-center justify-center shrink-0 w-40 md:w-56 h-20 p-2">
                <img
                  src={`/${slug}-logo.png`}
                  alt={`${oem} logo`}
                  width="160"
                  height="60"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  class="max-h-full max-w-full object-contain"
                  onerror={`this.style.display='none'; this.parentElement.querySelector('.oem-fallback').style.display='flex';`}
                />
                <div
                  class="oem-fallback items-center justify-center space-x-3 w-full"
                  style="display:none"
                >
                  <svg
                    class="w-8 h-8 text-slate-300 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M2 20a2 2 0 002 2h16a2 2 0 002-2V8l-6 4V8l-6 4V8l-6 4V4a2 2 0 00-2-2H4a2 2 0 00-2 2z" />
                  </svg>
                  <span class="text-sm md:text-base font-black text-slate-700 tracking-widest uppercase truncate">
                    {oem}
                  </span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ══ STATS ══ -->
  <section
    class="bg-slate-900 py-14 md:py-16 border-b border-slate-800"
    aria-labelledby="stats-heading"
  >
    <h2 id="stats-heading" class="sr-only">Company statistics</h2>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-16">
        {
          HOME_STATS.map(({ iconPath, end, suffix, label, sub }) => {
            // FIX (UX audit — "0" stat misread as missing data): the
            // penalty-claims stat is end===0 with no suffix, so it rendered
            // as a bare "0" indistinguishable from a loading/blank state.
            // Swap in an emerald checkmark treatment (icon + number color)
            // specifically for this zero-is-good case so it reads as an
            // achievement at a glance instead of an error.
            const isZeroAchievement = end === 0 && !suffix;
            return (
              <div class="text-center">
                <div

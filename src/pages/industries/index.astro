---
// src/pages/industries/index.astro
// Ported from IndustriesPage in App.jsx (line ~23643).
// Note: original used asymmetric routing (/industries index, /industry/:id
// detail, singular). This port uses /industries/:id consistently — a small
// intentional improvement, flagged here per your request to note any changes.
import Layout from "../../layouts/Layout.astro";
import { localizedPath } from "../../lib/localeMeta";
import Icon from "../../components/Icon.astro";
import type { Industry } from "../../data/industries";
import { CONTACT_INFO } from "../../data/site-config";
import { getLocalizedList, getLocalizedData } from "../../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const INDUSTRIES = getLocalizedList<Industry>("industries", locale);
const pageHeaders = getLocalizedData<
  Record<string, { metaTitle: string; metaDescription: string; h1: string; subheading: string }>
>("page-headers", locale).industries;
const IND_TESTIMONIALS = getLocalizedData<
  Record<string, { quote: string; credit: string; link: string | null }>
>("industry-testimonials", locale);

const waHref = (text: string) => `https://wa.me/${CONTACT_INFO.whatsapp}?text=${encodeURIComponent(text)}`;

/*
  FIXED (color-contrast): `ind.accent` (e.g. "text-yellow-500") is reused in
  four places with very different backgrounds — the turbine badge and
  checklist icons sit on dark/translucent panels where the 500 shades read
  fine, but the "Industry Focus" label below sits directly on white and six
  of the seven 500-weight accents fall short of 4.5:1 there (as low as
  1.91:1 for yellow). Rather than darkening the shared token — which would
  also dim it on the dark panels where it isn't broken — this maps each
  accent to a same-hue shade that clears 4.5:1 on white, used only for that
  one label. Shades not listed here (e.g. stone-500) already pass and are
  left as-is.
*/
const ACCENT_TEXT_ON_WHITE: Record<string, string> = {
  "text-yellow-500": "text-yellow-700", // 1.91:1 -> 4.93:1
  "text-green-500": "text-green-700", // 2.21:1 -> 4.95:1
  "text-blue-500": "text-blue-600", // 3.76:1 -> 5.25:1
  "text-orange-500": "text-orange-700", // 2.88:1 -> 5.22:1
  "text-purple-500": "text-purple-600", // 4.12:1 -> 5.54:1
  "text-lime-600": "text-lime-700", // 3.06:1 -> 4.98:1
};
---

<Layout
  title={pageHeaders.metaTitle}
  description={pageHeaders.metaDescription}
  keywords="power plant turbine service, sugar mill turbine maintenance, paper mill turbine, oil gas turbine engineering, petrochemical turbine spares, cement plant turbine, industrial turbine India, Keshav Enterprises"
  canonicalPath="/industries"
>
  <div class="bg-[#0A192F] text-white py-24 mb-16 border-b-8 border-blue-600 relative overflow-hidden pt-40">
    <img
      src="/industries-hero-bg.webp"
      alt=""
      aria-hidden="true"
      width="1920"
      height="700"
      loading="eager"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
      style="opacity:0.45;object-fit:cover;"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0 bg-[#0A192F]/45"></div>
    <div class="absolute inset-0 bg-linear-to-t from-[#0A192F]/65 via-transparent to-[#0A192F]/20"></div>
    <div class="absolute inset-0 opacity-10" style="background-image:linear-gradient(to right,#4f4f4f2e 1px,transparent 1px),linear-gradient(to bottom,#4f4f4f2e 1px,transparent 1px);background-size:4rem 4rem;" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center relative z-10">
      <h1 class="text-5xl md:text-6xl font-black mb-6 tracking-tight drop-shadow-lg">{pageHeaders.h1}</h1>
      <div class="w-24 h-1.5 bg-blue-500 mb-8 rounded-full" aria-hidden="true"></div>
      <p class="text-slate-300 font-medium max-w-3xl mx-auto text-xl md:text-2xl leading-relaxed">
        {pageHeaders.subheading}
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-12">
      {INDUSTRIES.map((ind, index) => (
        <article class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl hover:shadow-slate-300/60 transition-all duration-500 group border border-slate-200 bg-white w-full">
          <div class={`flex flex-col ${index % 2 !== 0 ? "lg:flex-row-reverse" : "lg:flex-row"}`}>
            <!-- LEFT: image infographic panel -->
            {/*
              FIXED (label-content-name-mismatch): as on the services page,
              this aria-label ("X — view industry details") replaced the
              accessible name but never included the card's actual visible
              content. Dropping the override lets the accessible name come
              from what's on screen instead.
            */}
            <a href={localizedPath(locale, `/industries/${ind.slug}`)} class="lg:w-2/5 relative overflow-hidden min-h-70 sm:min-h-85 lg:min-h-110 shrink-0 block focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-500" style="isolation:isolate">
              <div class={`absolute inset-0 bg-linear-to-br ${ind.color}`}></div>
              {ind.image && (
                <img
                  src={`/${ind.image}`} alt="" aria-hidden="true" width="560" height="440"
                  class="absolute inset-0 w-full h-full object-cover object-center"
                  loading="lazy" decoding="async" onerror="this.style.display='none'"
                />
              )}
              <div class="absolute inset-0 bg-[#0A192F]/60"></div>
              <div class="absolute inset-0" style="background:radial-gradient(ellipse at center,transparent 40%,rgba(10,25,47,0.5) 100%)"></div>

              <div class="relative z-10 w-full h-full p-10 flex flex-col items-center justify-center gap-6">
                <div class="w-24 h-24 bg-white/15 backdrop-blur-md rounded-3xl flex items-center justify-center border border-white/25 shadow-2xl group-hover:scale-110 group-hover:bg-white/25 transition-all duration-500">
                  <Icon name={ind.iconName} class="w-12 h-12 text-white drop-shadow-lg" />
                </div>
                <div class="text-center">
                  <h2 class="text-3xl font-black text-white tracking-tight drop-shadow-lg leading-tight mb-3">{ind.title}</h2>
                  <div class="h-1 w-16 rounded-full mx-auto mb-4 bg-white/50"></div>
                  <p class={`text-sm font-black ${ind.accent} bg-black/30 backdrop-blur-sm px-4 py-2 rounded-full uppercase tracking-widest border border-white/10 drop-shadow`}>{ind.turbines}</p>
                </div>
                <div class="flex flex-wrap justify-center gap-2 max-w-xs">
                  {ind.useCases.slice(0, 3).map((uc) => (
                    <span class="text-[10px] font-black text-white/90 bg-white/10 backdrop-blur-sm border border-white/15 px-3 py-1.5 rounded-full uppercase tracking-wide">
                      {uc.split(" ").slice(0, 3).join(" ")}
                    </span>
                  ))}
                </div>
                <div class="flex items-center gap-1.5 text-white/90 text-xs font-semibold bg-white/15 border border-white/25 rounded-full px-4 py-1.5 backdrop-blur-sm mt-1 group-hover:bg-white/25 transition-colors">
                  Explore Solutions
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"/></svg>
                </div>
              </div>
            </a>

            <!-- RIGHT: content panel -->
            <div class="lg:w-3/5 p-6 sm:p-10 lg:p-14 flex flex-col justify-center bg-white">
              <div class="inline-flex items-center gap-2 mb-6">
                <div class={`w-2 h-2 rounded-full ${ind.accent.replace("text-", "bg-")}`}></div>
                <span class={`text-xs font-black ${ACCENT_TEXT_ON_WHITE[ind.accent] ?? ind.accent} uppercase tracking-widest`}>Industry Focus</span>
              </div>
              <a href={localizedPath(locale, `/industries/${ind.slug}`)} class="focus:outline-none focus-visible:underline">
                <h3 class="text-2xl font-black text-slate-900 tracking-tight mb-5 leading-tight hover:text-blue-600 transition-colors">{ind.title}</h3>
              </a>
              <p class="text-slate-600 font-medium text-base leading-relaxed mb-8 border-l-4 border-slate-200 pl-5">{ind.desc}</p>
              <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-5">Key Applications &amp; Products</h4>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-10">
                {ind.useCases.map((uc) => (
                  <li class="flex items-start gap-3 bg-slate-50 rounded-xl px-4 py-3 border border-slate-100 hover:border-blue-200 hover:bg-blue-50/40 transition-colors">
                    <Icon name="CheckCircle2" class={`w-4 h-4 shrink-0 mt-0.5 ${ind.accent}`} />
                    <span class="text-slate-700 font-medium text-sm leading-snug">{uc}</span>
                  </li>
                ))}
              </ul>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-slate-100">
                {IND_TESTIMONIALS[ind.id] && (
                  <div class="sm:col-span-3 mb-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 flex gap-3 items-start">
                    <span class="text-blue-300 text-3xl font-black leading-none select-none shrink-0 -mt-1" aria-hidden="true">&ldquo;</span>
                    <div>
                      <p class="text-slate-700 font-medium text-sm leading-snug italic">{IND_TESTIMONIALS[ind.id].quote}</p>
                      <p class="text-slate-500 text-[11px] font-bold mt-1">— {IND_TESTIMONIALS[ind.id].credit}</p>
                    </div>
                  </div>
                )}
                <a
                  href={`/contact?service=${encodeURIComponent("General Inquiry")}&details=${encodeURIComponent(`Hi, I need engineering services for my ${ind.title} facility. Please contact me.`)}`}
                  aria-label={`Get a quote for ${ind.title} services`}
                  class="bg-blue-600 text-white px-5 py-3.5 rounded-xl font-black hover:bg-blue-700 transition-all shadow-sm flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 group/btn text-sm"
                >
                  Get a Quote
                  <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"/></svg>
                </a>
                <a
                  href={localizedPath(locale, `/industries/${ind.slug}`)}
                  aria-label={`Explore Solutions — ${ind.title}`}
                  class="bg-transparent text-blue-600 border border-blue-600 px-5 py-3.5 rounded-xl font-black hover:bg-blue-50 transition-all flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 group/btn text-sm"
                >
                  Explore Solutions
                  <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"/></svg>
                </a>
                <a
                  href={waHref(`Hello KESHAV ENTERPRISES, I need engineering services for my ${ind.title} facility.`)}
                  target="_blank" rel="noopener noreferrer"
                  aria-label={`WhatsApp inquiry for ${ind.title}`}
                  class="bg-whatsapp text-white px-5 py-3.5 rounded-xl font-black hover:bg-whatsapp-hover transition-all flex items-center justify-center gap-2 shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-green-400 text-sm"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                  WhatsApp
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <div class="bg-[#0A192F] py-16 mt-20 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-4">Don't see your industry?</h2>
      <p class="text-slate-300 font-medium mb-8">We work with any facility running steam turbines from 5 kW to 60 MW — tell us your setup.</p>
      <a href="/contact" class="inline-block bg-blue-600 text-white px-8 py-4 rounded-xl font-black hover:bg-blue-700 transition-all shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300">Talk to Our Engineers</a>
    </div>
  </div>
</Layout>
